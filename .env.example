# 构建时 / 本地工具变量，不会作为 Worker 机密注入。
# 本地复制为 .env。生产写在 Cloudflare Builds 的构建变量里。

# --- wrangler:prepare 必填（生成 wrangler.jsonc） ---
WORKER_NAME=my-blog
QUEUE_NAME=blog-queue
DOMAIN=blog.example.com
D1_DATABASE_ID=your-d1-database-id
KV_NAMESPACE_ID=your-kv-namespace-id
BUCKET_NAME=your-r2-bucket-name
# --- 域名绑定模式（可选，默认使用 Custom Domain 自定义域）---
# 若改用 Workers Routes 路由模式（如已有 DNS 代理记录），设为 1 即可；ZONE_NAME 默认从 DOMAIN 自动推导
# ROUTE=1
# ZONE_NAME=example.com

# --- 可选：构建时注入前端 ---
# 旧版博客标识的兼容默认值；管理后台站点设置优先。
# VITE_BLOG_TITLE=我的博客
# VITE_BLOG_AUTHOR=作者名
# VITE_BLOG_DESCRIPTION=博客介绍
# VITE_BLOG_GITHUB=https://github.com/your-username
# VITE_BLOG_EMAIL=your-email@example.com
# VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
# VITE_UMAMI_WEBSITE_ID=your-umami-website-id
# VITE_ICP_NUMBER=萌ICP备********号
# VITE_ICP_URL=https://icp.gov.moe/?keyword=你的备案号

# --- 本地 Drizzle（db:studio、db:push），不进 Worker ---
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_TOKEN=your-d1-api-token
